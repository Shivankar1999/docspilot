# Copy to .env for local development:  cp .env.example .env
# Values below match docker-compose.yml, so they work out of the box.

# --- API (apps/api) ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Docker Postgres is published on 5433 to avoid clashing with a local Postgres on 5432.
DATABASE_URL=postgres://docspilot:docspilot@localhost:5433/docspilot
REDIS_URL=redis://localhost:6379/0

# Signs dashboard session tokens (min 32 chars). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-32-plus-chars

# Embeddings. "mock" runs offline with no key (fine for trying the app);
# "voyage" uses Voyage AI (https://dash.voyageai.com for a key).
# Switching providers changes the vector space: re-upload documents afterwards.
EMBEDDING_PROVIDER=mock
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# Chat answers. "mock" is free and offline: it answers by quoting your documents.
# "anthropic" uses Claude (https://console.anthropic.com for a key). CHAT_MODEL can
# be any Claude model ID, e.g. claude-haiku-5-5 for the cheapest option.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5

# Optional: override the embedding model's relevance threshold (0 to 1).
# RETRIEVAL_MIN_SIMILARITY=0.35

# Chat rate limits per sliding 60-second window, and answer-cache lifetime.
RATE_LIMIT_IP_PER_MIN=20
RATE_LIMIT_TENANT_PER_MIN=120
CACHE_TTL_SECONDS=86400

# Platform operators (comma-separated emails) who can open /dashboard/admin.
# Put the email you sign up with here to see the admin page.
ADMIN_EMAILS=

# Proxies allowed to set X-Forwarded-For (Express "trust proxy" syntax). The default
# trusts private networks only, so public clients can't fake their IP.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Uploaded files (default: apps/api/uploads). The API and worker must share it.
# UPLOAD_DIR=

# Serverless settings. On Vercel (VERCEL=1) these default to blob / inline / 4, so
# nothing needs setting there; see docs/DEPLOYMENT.md.
#   STORAGE_DRIVER: "local" (UPLOAD_DIR) or "blob" (private Vercel Blob storage)
#   INGEST_MODE:    "queue" (BullMQ + the worker process) or "inline" (the API ingests
#                   in the background after each upload; no worker needed)
#   MAX_UPLOAD_MB:  largest upload (Vercel Functions reject bodies over 4.5 MB)
# STORAGE_DRIVER=local
# INGEST_MODE=queue
# MAX_UPLOAD_MB=10

# Tests use a separate database (docspilot_test, created automatically) and
# Redis DB 1, so running tests never wipes your dev data. Their defaults live in
# apps/api/vitest.config.mts; set TEST_DATABASE_URL / TEST_REDIS_URL in your
# shell (as CI does) to point tests elsewhere.

# --- Web (apps/web) ---
# Where the Next.js server reaches the API.
API_URL=http://localhost:4000
